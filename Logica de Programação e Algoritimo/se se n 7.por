programa {
  funcao inicio() {
    inteiro num1,num2
    cadeia numero_maior

    escreva("digite o primeiro  numero")
    leia(num1)

    escreva("digite segundo numero")
    leia(num2)

    se(num1>num2){
      escreva("num1>num2")
    }
    senao se(num1>num2){
      escreva("num1<num2")
    }
    senao se(num1==num2){
      escreva("os numeros são igauis")
    }
    


    
  }
}
