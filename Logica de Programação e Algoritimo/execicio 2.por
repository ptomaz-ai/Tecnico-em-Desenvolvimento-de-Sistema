programa {
  funcao inicio() {
    real area,raio,altura,volume,pi=3.14

    escreva("digita o raio:")
    leia(raio)
    
    escreva("digite a altura")
    leia(altura)

     area=2*pi*raio*(altura)
    escreva("area é=",area)

    volume=pi*raio*raio*altura
    escreva("volume é =",volume)



  }
}
